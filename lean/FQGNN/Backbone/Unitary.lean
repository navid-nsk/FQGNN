import Mathlib

/-!
# The unitary coupling chart `U = exp(iH)`, `H = ½(A + Aᴴ)`

Formalizes Lemma S2.7 and the `U`-side of Corollary S2.10 of the Supplementary Information
(SI §S2.5), which the manuscript uses in Methods, eq. (10) and the sentence after it
("The coupling matrix is parameterized as `U = exp(iH)` with `H = ½(A + Aᴴ)` Hermitian, which is
unitary for every value of the underlying parameters").

Contents: the Hermitian part, unitarity of `exp (I • H)`, and the corollary for the composite
parameterization and for arbitrary discrete-time update sequences.

The matrix exponential is Mathlib's `NormedSpace.exp` on `Matrix (Fin n) (Fin n) ℂ`; the lemmas
`Matrix.exp_conjTranspose`, `Matrix.exp_add_of_commute` hide the choice of matrix norm.
-/

open Matrix NormedSpace

namespace FQGNN.Backbone

variable {n : ℕ}

/-- The Hermitian part `H = ½ (A + Aᴴ)` of a complex square matrix `A` (SI §S2.1 statement of
Prop. 2 and Lemma S2.7; manuscript Methods). -/
noncomputable def hermPart (A : Matrix (Fin n) (Fin n) ℂ) : Matrix (Fin n) (Fin n) ℂ :=
  (1 / 2 : ℂ) • (A + Aᴴ)

/-- The coupling chart `A ↦ U = exp(i H)`, `H = ½ (A + Aᴴ)` (manuscript eq. (10) paragraph;
SI Lemma S2.7). -/
noncomputable def couplingU (A : Matrix (Fin n) (Fin n) ℂ) : Matrix (Fin n) (Fin n) ℂ :=
  exp (Complex.I • hermPart A)

/-- **SI Lemma S2.7, first clause** (manuscript Methods): for every complex square
matrix `A`, `H = ½ (A + Aᴴ)` is Hermitian. -/
theorem hermPart_isHermitian (A : Matrix (Fin n) (Fin n) ℂ) : (hermPart A).IsHermitian := by
  unfold hermPart Matrix.IsHermitian
  rw [conjTranspose_smul, conjTranspose_add, conjTranspose_conjTranspose, add_comm]
  congr 1
  simp

/-- For a Hermitian `H`, `(i H)ᴴ = -(i H)`: `i H` is skew-Hermitian (step of the proof of
SI Lemma S2.7). -/
theorem conjTranspose_I_smul_of_isHermitian {H : Matrix (Fin n) (Fin n) ℂ}
    (hH : H.IsHermitian) : (Complex.I • H)ᴴ = -(Complex.I • H) := by
  rw [conjTranspose_smul, hH.eq, ← neg_smul]
  congr 1
  simp

/-- `exp (-X) * exp X = 1` for complex square matrices (used for SI Lemma S2.7). -/
theorem exp_neg_mul_exp (X : Matrix (Fin n) (Fin n) ℂ) : exp (-X) * exp X = 1 := by
  rw [← Matrix.exp_add_of_commute _ _ (Commute.neg_left (Commute.refl X)), neg_add_cancel,
    exp_zero]

/-- `exp X * exp (-X) = 1` for complex square matrices (used for SI Lemma S2.7). -/
theorem exp_mul_exp_neg (X : Matrix (Fin n) (Fin n) ℂ) : exp X * exp (-X) = 1 := by
  rw [← Matrix.exp_add_of_commute _ _ (Commute.neg_right (Commute.refl X)), add_neg_cancel,
    exp_zero]

/-- **SI Lemma S2.7, second clause** (manuscript Methods):
for every Hermitian `H`, `U = exp (i H)` is unitary, i.e. `U ∈ U(n)`
(`Matrix.unitaryGroup`, equivalently `Uᴴ U = 1` and `U Uᴴ = 1`). The proof is the SI one:
`Uᴴ = exp((iH)ᴴ) = exp(-iH) = U⁻¹`. -/
theorem exp_I_smul_mem_unitaryGroup {H : Matrix (Fin n) (Fin n) ℂ} (hH : H.IsHermitian) :
    exp (Complex.I • H) ∈ Matrix.unitaryGroup (Fin n) ℂ := by
  rw [Matrix.mem_unitaryGroup_iff, Matrix.star_eq_conjTranspose, ← Matrix.exp_conjTranspose,
    conjTranspose_I_smul_of_isHermitian hH]
  exact exp_mul_exp_neg _

/-- **Explicit form** (SI Lemma S2.7): for Hermitian `H` and `U = exp (i H)`,
both `Uᴴ * U = 1` and `U * Uᴴ = 1`. -/
theorem exp_I_smul_unitary {H : Matrix (Fin n) (Fin n) ℂ} (hH : H.IsHermitian) :
    (exp (Complex.I • H))ᴴ * exp (Complex.I • H) = 1 ∧
      exp (Complex.I • H) * (exp (Complex.I • H))ᴴ = 1 := by
  rw [← Matrix.exp_conjTranspose, conjTranspose_I_smul_of_isHermitian hH]
  exact ⟨exp_neg_mul_exp _, exp_mul_exp_neg _⟩

/-- **Corollary: SI Lemma S2.7 (composite chart) / Cor. S2.10 (`U`-side)** (manuscript
Methods: "unitary for every value of the underlying parameters"): for **every** complex
square matrix `A`, `exp (i • ½ (A + Aᴴ)) ∈ U(n)`. Real parameters `A` are covered by
`couplingU_mem_unitaryGroup_of_real`. -/
theorem couplingU_mem_unitaryGroup (A : Matrix (Fin n) (Fin n) ℂ) :
    couplingU A ∈ Matrix.unitaryGroup (Fin n) ℂ :=
  exp_I_smul_mem_unitaryGroup (hermPart_isHermitian A)

/-- **SI Lemma S2.7, real parameters** ("for every `A` (real or complex)"): for a real matrix
`A : Matrix (Fin n) (Fin n) ℝ`, viewed in `ℂ` entrywise, the coupling `U` is unitary. -/
theorem couplingU_mem_unitaryGroup_of_real (A : Matrix (Fin n) (Fin n) ℝ) :
    couplingU (A.map (fun x : ℝ => (x : ℂ))) ∈ Matrix.unitaryGroup (Fin n) ℂ :=
  couplingU_mem_unitaryGroup _

/-- The parameter sequence generated by an arbitrary (time-dependent) discrete update rule
`T t : Matrix → Matrix` from an initial value `A₀` (SI Prop. S2.5(ii), "any sequence of maps"). -/
def updateSeqA (T : ℕ → Matrix (Fin n) (Fin n) ℂ → Matrix (Fin n) (Fin n) ℂ)
    (A₀ : Matrix (Fin n) (Fin n) ℂ) : ℕ → Matrix (Fin n) (Fin n) ℂ
  | 0 => A₀
  | t + 1 => T t (updateSeqA T A₀ t)

/-- **SI Cor. S2.10 (every-step `U`-side guarantee)**: for **any** update rule `T` (gradient step,
momentum, adaptive, scheduled, …) and any initial parameter `A₀`, the coupling
`U_t = exp(i ½ (A_t + A_tᴴ))` is unitary at every step `t`. No projection or penalty is involved:
the parameter domain is unconstrained. -/
theorem couplingU_update_mem_unitaryGroup
    (T : ℕ → Matrix (Fin n) (Fin n) ℂ → Matrix (Fin n) (Fin n) ℂ)
    (A₀ : Matrix (Fin n) (Fin n) ℂ) (t : ℕ) :
    couplingU (updateSeqA T A₀ t) ∈ Matrix.unitaryGroup (Fin n) ℂ :=
  couplingU_mem_unitaryGroup _

/-- **SI Cor. S2.10, history-dependent form**: for an **arbitrary** parameter trajectory
`A : ℕ → Matrix` (which covers every history-dependent update rule, since any such rule produces
some trajectory), `couplingU (A t)` is unitary for every `t`. -/
theorem couplingU_traj_mem_unitaryGroup (A : ℕ → Matrix (Fin n) (Fin n) ℂ) (t : ℕ) :
    couplingU (A t) ∈ Matrix.unitaryGroup (Fin n) ℂ :=
  couplingU_mem_unitaryGroup _

end FQGNN.Backbone
