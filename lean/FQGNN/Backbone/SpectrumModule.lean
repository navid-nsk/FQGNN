import FQGNN.Backbone.TorusEmbedding
import FQGNN.Backbone.Chart

/-!
# The spectrum module `M_L = Lᵀ ℤⁿ`, its ℚ-rank, density, and the extinction-thinned `Λ'`

This module formalizes the ambient Bragg module of the FQ spectrum, its rational rank, its
density, and the discreteness of the extinction-thinned spectral support:

* Manuscript eq. (1): `Λ' = {Lᵀk : k ∈ ℤⁿ, var(k) < d}`.
* SI §S1.1 (rational independence as "no nonzero `k ∈ ℤⁿ` has `Lᵀk = 0`") and SI §S1 (the
  spectral support `Λ'` is discrete and nonlattice; the ambient module is the dense object).

Main results:

* `spectrumModule L` — the ambient module `M_L = {Lᵀk : k ∈ ℤⁿ}` as an additive subgroup of
  `ℝᵈ`; `transpose_mulVec_intCast` (`Lᵀk = Σ_j k_j • ℓ_j`), `spectrumModule_eq_closure`, and
  `span_spectrumModule` (`span_ℚ M_L = span_ℚ {rows}`).
* `finrank_span_spectrumModule_le`, `finrank_span_spectrumModule_eq_iff` — ℚ-rank `≤ n`, with
  equality iff the rows are ℚ-linearly independent; `linearIndependent_rat_iff` —
  ℚ-independence of the rows ↔ no nonzero integer relation `Lᵀk = 0`.
* `dense_spectrumModule1` — `d = 1` density from an irrational ratio.
* `exists_small_nonzero_mem_spectrumModule`, `no_exclusion_zone` — no exclusion zone for the
  ambient module (`d = 1`, irrational ratio).
* `signVar`, `extinctionSpectrum`, `extinctionSpectrum_subset`, `neg_mem_extinctionSpectrum_iff`
  — the extinction-thinned spectrum `Λ'` is a symmetric subset of `M_L`.
* `extinctionSpectrum_exclusion_zone_of_inGrPlus2`, `extinctionSpectrum_colGen_discrete`,
  `extinctionSpectrum_vs_spectrumModule` — for a totally positive generator (`d = 1`, and the
  deployed `d = 2`), the **thinned** set `Λ'` is locally finite with an exclusion zone at the
  origin, whereas the **ambient** module `M_L` can be dense (for `d = 1`, under an irrational
  ratio; in general exactly under the aperiodicity condition, `dense_spectrumModule_iff` in
  `FQGNN.Backbone.Kronecker`). This is the distinction drawn in SI §S1.
-/

noncomputable section

open Matrix

namespace FQGNN.Backbone

variable {n d : ℕ}

/-! ## The ambient module `M_L` -/

/-- The ℤ-linear map `k ↦ Lᵀ k`, `ℤⁿ → ℝᵈ`.

Source: manuscript eq. (1) (`ξ = Lᵀk`). -/
def specHom (L : Matrix (Fin n) (Fin d) ℝ) : (Fin n → ℤ) →+ (Fin d → ℝ) where
  toFun k := Lᵀ *ᵥ (fun j => (k j : ℝ))
  map_zero' := by
    have h : (fun j => ((0 : Fin n → ℤ) j : ℝ)) = 0 := by
      funext j
      simp
    rw [h, mulVec_zero]
  map_add' a b := by
    have h : (fun j => ((a + b) j : ℝ)) = (fun j => (a j : ℝ)) + (fun j => (b j : ℝ)) := by
      funext j
      simp
    rw [h, mulVec_add]

/-- The **ambient spectrum module** `M_L = {Lᵀk : k ∈ ℤⁿ} ⊆ ℝᵈ` (the ℤ-module inside which the
Lee–Yang extinction rule `var(k) < d` selects the surviving frequencies `Λ'`).

Source: manuscript eq. (1); SI §S1 (the ambient module `Lᵀℤⁿ`). -/
def spectrumModule (L : Matrix (Fin n) (Fin d) ℝ) : AddSubgroup (Fin d → ℝ) :=
  (specHom L).range

/-- Membership in `M_L`: `ξ ∈ M_L ↔ ∃ k ∈ ℤⁿ, Lᵀk = ξ`.

Source: manuscript eq. (1). -/
theorem mem_spectrumModule_iff (L : Matrix (Fin n) (Fin d) ℝ) (ξ : Fin d → ℝ) :
    ξ ∈ spectrumModule L ↔ ∃ k : Fin n → ℤ, Lᵀ *ᵥ (fun j => (k j : ℝ)) = ξ :=
  AddMonoidHom.mem_range

/-- **Row expansion.** `Lᵀ k = Σ_j k_j • ℓ_j`, where `ℓ_j = L j` is the `j`-th row of `L`. -/
theorem transpose_mulVec_intCast (L : Matrix (Fin n) (Fin d) ℝ) (k : Fin n → ℤ) :
    Lᵀ *ᵥ (fun j => (k j : ℝ)) = ∑ j, k j • L.row j := by
  funext c
  simp only [mulVec, dotProduct, transpose_apply, Finset.sum_apply,
    zsmul_eq_mul]
  exact Finset.sum_congr rfl fun j _ => mul_comm _ _

/-- Each generator row `ℓ_j` lies in `M_L`. -/
theorem row_mem_spectrumModule (L : Matrix (Fin n) (Fin d) ℝ) (j : Fin n) :
    L.row j ∈ spectrumModule L := by
  refine (mem_spectrumModule_iff L _).2 ⟨Pi.single j 1, ?_⟩
  rw [transpose_mulVec_intCast]
  simp [Pi.single_apply]

/-- **Generation.** `M_L` is the additive subgroup generated by the rows of `L`. -/
theorem spectrumModule_eq_closure (L : Matrix (Fin n) (Fin d) ℝ) :
    spectrumModule L = AddSubgroup.closure (Set.range L.row) := by
  apply le_antisymm
  · rintro ξ hξ
    obtain ⟨k, rfl⟩ := (mem_spectrumModule_iff L ξ).1 hξ
    rw [transpose_mulVec_intCast]
    exact AddSubgroup.sum_mem _ fun j _ =>
      AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure (Set.mem_range_self j)) _
  · rw [AddSubgroup.closure_le]
    rintro _ ⟨j, rfl⟩
    exact row_mem_spectrumModule L j

/-- **ℚ-span identity.** `span_ℚ M_L = span_ℚ {ℓ_1, …, ℓ_n}` in `ℝᵈ` viewed as a
`ℚ`-vector space.

The ℚ-dimension of the spectrum module is the ℚ-dimension of the span of the generator rows
(SI §S1.1). -/
theorem span_spectrumModule (L : Matrix (Fin n) (Fin d) ℝ) :
    Submodule.span ℚ (spectrumModule L : Set (Fin d → ℝ)) = Submodule.span ℚ (Set.range L.row) := by
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro ξ hξ
    obtain ⟨k, rfl⟩ := (mem_spectrumModule_iff L ξ).1 hξ
    rw [transpose_mulVec_intCast]
    refine Submodule.sum_mem _ fun j _ => ?_
    rw [← Int.cast_smul_eq_zsmul ℚ]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_range_self j))
  · apply Submodule.span_mono
    rintro _ ⟨j, rfl⟩
    exact row_mem_spectrumModule L j

/-! ## The ℚ-rank of the spectrum module -/

/-- **Rank bound.** `dim_ℚ span_ℚ(M_L) ≤ n`.

Source: SI §S1.1; cf. [AKKV2024, Thm 2.6(2)]. -/
theorem finrank_span_spectrumModule_le (L : Matrix (Fin n) (Fin d) ℝ) :
    Module.finrank ℚ (Submodule.span ℚ (spectrumModule L : Set (Fin d → ℝ))) ≤ n := by
  rw [span_spectrumModule]
  have h := finrank_range_le_card (R := ℚ) L.row
  rw [Fintype.card_fin] at h
  exact h

/-- **Rank equality.** `dim_ℚ span_ℚ(M_L) = n` iff the rows of `L` are ℚ-linearly
independent.

The rank is `n` only under ℚ-independence of the rows; in general it can be smaller.

Source: SI §S1.1; cf. [AKKV2024, Thm 2.6(2)]. -/
theorem finrank_span_spectrumModule_eq_iff (L : Matrix (Fin n) (Fin d) ℝ) :
    Module.finrank ℚ (Submodule.span ℚ (spectrumModule L : Set (Fin d → ℝ))) = n ↔
      LinearIndependent ℚ L.row := by
  rw [span_spectrumModule, linearIndependent_iff_card_eq_finrank_span, Fintype.card_fin,
    Set.finrank, eq_comm]

/-- ℚ-independence of the generator rows is equivalent to the absence of a nonzero integer
relation `Lᵀ k = 0`, `k ∈ ℤⁿ` (the form used in SI §S1.1).

Source: SI §S1.1 ("rationally independent (no nonzero `k ∈ ℤⁿ` has `Lᵀk = 0`)"). -/
theorem linearIndependent_rat_iff (L : Matrix (Fin n) (Fin d) ℝ) :
    LinearIndependent ℚ L.row ↔ ∀ k : Fin n → ℤ, Lᵀ *ᵥ (fun j => (k j : ℝ)) = 0 → k = 0 := by
  rw [← LinearIndependent.iff_fractionRing ℤ ℚ, Fintype.linearIndependent_iff]
  refine forall_congr' fun k => ?_
  rw [transpose_mulVec_intCast]
  exact ⟨fun h hk => funext (h hk), fun h hk i => congrFun (h hk) i⟩

/-- **Corollary.** The ℚ-rank of `M_L` is `n` iff `k ↦ Lᵀk` is injective on `ℤⁿ`
(i.e. `M_L ≅ ℤⁿ`, a rank-`n` ℤ-module).

Source: SI §S1.1. -/
theorem finrank_span_spectrumModule_eq_iff_injective (L : Matrix (Fin n) (Fin d) ℝ) :
    Module.finrank ℚ (Submodule.span ℚ (spectrumModule L : Set (Fin d → ℝ))) = n ↔
      Function.Injective (specHom L) := by
  rw [finrank_span_spectrumModule_eq_iff, linearIndependent_rat_iff,
    injective_iff_map_eq_zero]
  rfl

/-! ## Density for `d = 1` -/

/-- The `d = 1` spectrum module `Σ_j ℤ L_j ⊆ ℝ` of a scalar generator `L ∈ ℝⁿ` (as a group
homomorphism from `ℤⁿ`). -/
def specHom1 (L : Fin n → ℝ) : (Fin n → ℤ) →+ ℝ where
  toFun k := ∑ j, (k j : ℝ) * L j
  map_zero' := by simp
  map_add' a b := by
    simp only [Pi.add_apply, Int.cast_add, add_mul]
    exact Finset.sum_add_distrib

/-- The `d = 1` spectrum module `M_L = {Σ_j k_j L_j : k ∈ ℤⁿ} ⊆ ℝ`. -/
def spectrumModule1 (L : Fin n → ℝ) : AddSubgroup ℝ :=
  (specHom1 L).range

/-- Membership in the `d = 1` module. -/
theorem mem_spectrumModule1_iff (L : Fin n → ℝ) (x : ℝ) :
    x ∈ spectrumModule1 L ↔ ∃ k : Fin n → ℤ, ∑ j, (k j : ℝ) * L j = x :=
  AddMonoidHom.mem_range

/-- The scalar module is the general module of the `n × 1` generator `colGen L`, read in the
single coordinate. -/
theorem mem_spectrumModule_colGen_iff (L : Fin n → ℝ) (ξ : Fin 1 → ℝ) :
    ξ ∈ spectrumModule (colGen L) ↔ ξ 0 ∈ spectrumModule1 L := by
  rw [mem_spectrumModule_iff, mem_spectrumModule1_iff]
  refine exists_congr fun k => ?_
  have h : ∀ c : Fin 1, ((colGen L)ᵀ *ᵥ (fun j => (k j : ℝ))) c = ∑ j, (k j : ℝ) * L j := by
    intro c
    simp only [mulVec, dotProduct, transpose_apply, colGen, replicateCol_apply]
    exact Finset.sum_congr rfl fun j _ => mul_comm _ _
  constructor
  · rintro hk
    rw [← hk, h]
  · intro hk
    funext c
    rw [h, hk, Fin.fin_one_eq_zero c]

/-- Each generator entry `L_i` lies in the `d = 1` module. -/
theorem entry_mem_spectrumModule1 (L : Fin n → ℝ) (i : Fin n) : L i ∈ spectrumModule1 L := by
  refine (mem_spectrumModule1_iff L _).2 ⟨Pi.single i 1, ?_⟩
  simp [Pi.single_apply]

/-- **Density, `d = 1`.** If some generator entry `L i ≠ 0` has an irrational ratio
`L j / L i` with another entry, the spectrum module `Σ_j ℤ L_j` is dense in `ℝ`.

Proof: by `AddSubgroup.dense_or_cyclic` the subgroup is dense or cyclic; if it were cyclic,
`ℤa`, then `L i = m_i a`, `L j = m_j a` with `m_i ≠ 0`, so `L j / L i = m_j / m_i ∈ ℚ`.

For a Fibonacci-type generator (entries `1` and the golden ratio) the module is therefore dense
in `ℝ`. Source: SI §S1 (density of the ambient module). -/
theorem dense_spectrumModule1 {L : Fin n → ℝ} (h : ∃ i j, L i ≠ 0 ∧ Irrational (L j / L i)) :
    Dense (spectrumModule1 L : Set ℝ) := by
  obtain ⟨i, j, hi, hirr⟩ := h
  rcases AddSubgroup.dense_or_cyclic (spectrumModule1 L) with hd | ⟨a, ha⟩
  · exact hd
  · exfalso
    have hLi := entry_mem_spectrumModule1 L i
    have hLj := entry_mem_spectrumModule1 L j
    rw [ha, AddSubgroup.mem_closure_singleton] at hLi hLj
    obtain ⟨mi, hmi⟩ := hLi
    obtain ⟨mj, hmj⟩ := hLj
    rw [zsmul_eq_mul] at hmi hmj
    have hmi0 : (mi : ℝ) ≠ 0 := by
      rintro h0
      apply hi
      rw [← hmi, h0, zero_mul]
    have ha0 : a ≠ 0 := by
      rintro rfl
      apply hi
      rw [← hmi, mul_zero]
    apply hirr
    refine ⟨(mj : ℚ) / mi, ?_⟩
    push_cast
    rw [← hmi, ← hmj]
    field_simp

/-- **Density in the ambient form.** Under the same hypothesis, the spectrum module
`M_L ⊆ ℝ¹` of the `n × 1` generator is dense. -/
theorem dense_spectrumModule_colGen {L : Fin n → ℝ}
    (h : ∃ i j, L i ≠ 0 ∧ Irrational (L j / L i)) :
    Dense (spectrumModule (colGen L) : Set (Fin 1 → ℝ)) := by
  have hd := dense_spectrumModule1 h
  have hset : (spectrumModule (colGen L) : Set (Fin 1 → ℝ)) =
      (Homeomorph.funUnique (Fin 1) ℝ).symm '' (spectrumModule1 L : Set ℝ) := by
    ext ξ
    constructor
    · intro hξ
      refine ⟨ξ 0, (mem_spectrumModule_colGen_iff L ξ).1 hξ, ?_⟩
      funext c
      rw [Fin.fin_one_eq_zero c]
      rfl
    · rintro ⟨x, hx, rfl⟩
      exact (mem_spectrumModule_colGen_iff L _).2 hx
  rw [hset]
  exact (Homeomorph.funUnique (Fin 1) ℝ).symm.surjective.denseRange.dense_image
    (Homeomorph.funUnique (Fin 1) ℝ).symm.continuous hd

/-! ## No exclusion zone for the ambient module -/

/-- **No exclusion zone, `d = 1`.** Under the irrational-ratio hypothesis, for every
`ε > 0` there is a nonzero spectrum point `ξ ∈ M_L` with `|ξ| < ε`: nonzero Bragg peaks
accumulate at the origin. -/
theorem exists_small_nonzero_mem_spectrumModule1 {L : Fin n → ℝ}
    (h : ∃ i j, L i ≠ 0 ∧ Irrational (L j / L i)) {ε : ℝ} (hε : 0 < ε) :
    ∃ ξ ∈ spectrumModule1 L, ξ ≠ 0 ∧ |ξ| < ε := by
  obtain ⟨c, hc, hc0, hcε⟩ := (dense_spectrumModule1 h).exists_between hε
  exact ⟨c, hc, hc0.ne', by rwa [abs_of_pos hc0]⟩

/-- **No exclusion zone, ambient form.** Under the irrational-ratio hypothesis, for every
`ε > 0` there is `ξ ∈ M_L ⊆ ℝ¹`, `ξ ≠ 0`, `‖ξ‖ < ε`. -/
theorem exists_small_nonzero_mem_spectrumModule {L : Fin n → ℝ}
    (h : ∃ i j, L i ≠ 0 ∧ Irrational (L j / L i)) {ε : ℝ} (hε : 0 < ε) :
    ∃ ξ ∈ spectrumModule (colGen L), ξ ≠ 0 ∧ ‖ξ‖ < ε := by
  obtain ⟨x, hx, hx0, hxε⟩ := exists_small_nonzero_mem_spectrumModule1 h hε
  refine ⟨fun _ => x, (mem_spectrumModule_colGen_iff L _).2 hx, fun h0 => hx0 (congrFun h0 0),
    ?_⟩
  rw [pi_norm_lt_iff hε]
  intro _
  rwa [Real.norm_eq_abs]

/-- **No exclusion zone, negated form.** Under the irrational-ratio hypothesis there is
no `ε > 0` such that every nonzero spectrum point has `|ξ| ≥ ε`, i.e. no punctured ball around
the origin is free of Bragg peaks: the ambient module is not "stealthy". -/
theorem no_exclusion_zone {L : Fin n → ℝ} (h : ∃ i j, L i ≠ 0 ∧ Irrational (L j / L i)) :
    ¬ ∃ ε > 0, ∀ ξ ∈ spectrumModule1 L, ξ ≠ 0 → ε ≤ |ξ| := by
  rintro ⟨ε, hε, hball⟩
  obtain ⟨ξ, hξ, hξ0, hξε⟩ := exists_small_nonzero_mem_spectrumModule1 h hε
  exact (hball ξ hξ hξ0).not_gt hξε

/-! ## The extinction-thinned spectrum `Λ'` -/

/-- Number of sign changes of a list of integers (adjacent pairs with negative product).

Source: manuscript eq. (1) (`var(k)`). -/
def signChanges : List ℤ → ℕ
  | a :: b :: l => (if a * b < 0 then 1 else 0) + signChanges (b :: l)
  | _ => 0

/-- Negating every entry does not change the number of sign changes. -/
theorem signChanges_map_neg : ∀ l : List ℤ, signChanges (l.map (fun a => -a)) = signChanges l
  | a :: b :: l => by
      have ih := signChanges_map_neg (b :: l)
      simp only [List.map_cons] at ih ⊢
      simp only [signChanges, neg_mul_neg, ih]
  | [_] => rfl
  | [] => rfl

/-- `var(k)`: the number of sign changes of the sequence of **nonzero** entries of `k ∈ ℤⁿ`.

Source: manuscript eq. (1) (AKKV Thm 2.3 Eq. 2). -/
def signVar (k : Fin n → ℤ) : ℕ :=
  signChanges ((List.ofFn k).filter (fun a => a ≠ 0))

/-- `var(−k) = var(k)` (symmetry of the extinction rule). -/
theorem signVar_neg (k : Fin n → ℤ) : signVar (-k) = signVar k := by
  unfold signVar
  have h1 : List.ofFn (-k) = (List.ofFn k).map (fun a => -a) := by
    rw [List.map_ofFn]
    rfl
  rw [h1, List.filter_map]
  have h2 : ((fun a : ℤ => decide (a ≠ 0)) ∘ fun a => -a) = fun a => decide (a ≠ 0) := by
    funext a
    simp
  rw [h2, signChanges_map_neg]

/-- The extinction-thinned spectrum `Λ' = {Lᵀk : k ∈ ℤⁿ, var(k) < d}`.

Source: manuscript eq. (1). -/
def extinctionSpectrum (L : Matrix (Fin n) (Fin d) ℝ) : Set (Fin d → ℝ) :=
  {ξ | ∃ k : Fin n → ℤ, signVar k < d ∧ Lᵀ *ᵥ (fun j => (k j : ℝ)) = ξ}

/-- `Λ' ⊆ M_L`: the rule `var(k) < d` is the Lee–Yang thinning inside the ambient Bragg module.

Source: manuscript eq. (1). -/
theorem extinctionSpectrum_subset (L : Matrix (Fin n) (Fin d) ℝ) :
    extinctionSpectrum L ⊆ spectrumModule L := by
  rintro ξ ⟨k, -, hk⟩
  exact (mem_spectrumModule_iff L ξ).2 ⟨k, hk⟩

/-- `Λ' = −Λ'`: `ξ ∈ Λ' ↔ −ξ ∈ Λ'` (consistent with the Hermitian symmetry
`c_{−k} = c̄_k` that justifies the cos + sin split). -/
theorem neg_mem_extinctionSpectrum_iff (L : Matrix (Fin n) (Fin d) ℝ) (ξ : Fin d → ℝ) :
    -ξ ∈ extinctionSpectrum L ↔ ξ ∈ extinctionSpectrum L := by
  have key : ∀ η : Fin d → ℝ, η ∈ extinctionSpectrum L → -η ∈ extinctionSpectrum L := by
    rintro η ⟨k, hk, rfl⟩
    refine ⟨-k, by rwa [signVar_neg], ?_⟩
    rw [← mulVec_neg]
    congr 1
    funext j
    simp
  exact ⟨fun h => by simpa using key _ h, key ξ⟩

/-- For `d ≥ 1`, `0 ∈ Λ'` (the density atom `ξ = 0`, `k = 0`, survives). -/
theorem zero_mem_extinctionSpectrum (L : Matrix (Fin n) (Fin d) ℝ) (hd : 0 < d) :
    (0 : Fin d → ℝ) ∈ extinctionSpectrum L := by
  refine ⟨0, ?_, ?_⟩
  · have h0 : signVar (0 : Fin n → ℤ) = 0 := by
      unfold signVar
      have : (List.ofFn (0 : Fin n → ℤ)).filter (fun a => a ≠ 0) = [] := by
        rw [List.filter_eq_nil_iff]
        intro a ha
        obtain ⟨i, rfl⟩ := List.mem_ofFn.1 ha
        simp
      rw [this]
      rfl
    rw [h0]
    exact hd
  · exact (specHom L).map_zero

/-! ## The thinned spectrum `Λ'` has an exclusion zone for totally positive `L` (`d = 1, 2`)

Density and the absence of an exclusion zone hold for the **ambient** module `M_L` (for `d = 1`
under an irrational ratio, see above), but the **sign-variation-thinned** set `Λ' = {Lᵀk : var(k) < d}` behaves oppositely when `L` is totally
positive: `k ↦ Lᵀk` is coercive on `{var(k) < d}`, so `Λ'` is locally finite and has an exclusion zone
around the origin.  This is the statement of SI §S1 ("the amplitude-carrying spectral support `Λ'`
… is a discrete, nonlattice set … the ambient … module is by contrast topologically dense").
-/

/-- Unfolding `signChanges` on a list with two leading entries. -/
lemma signChanges_cons_cons (a b : ℤ) (l : List ℤ) :
    signChanges (a :: b :: l) = (if a * b < 0 then 1 else 0) + signChanges (b :: l) := rfl

/-- A nonzero sequence without sign changes has pairwise positive products. -/
theorem pairwise_pos_of_signChanges_eq_zero :
    ∀ l : List ℤ, (∀ x ∈ l, x ≠ 0) → signChanges l = 0 → ∀ x ∈ l, ∀ y ∈ l, 0 < x * y
  | [], _, _ => by simp
  | [a], h, _ => by
      intro x hx y hy
      rw [List.mem_singleton] at hx hy
      obtain rfl := hx
      obtain rfl := hy
      exact mul_self_pos.2 (h _ (List.mem_singleton_self _))
  | a :: b :: t, h, h0 => by
      rw [signChanges_cons_cons] at h0
      have ha : a ≠ 0 := h a (by simp)
      have hb : b ≠ 0 := h b (by simp)
      have hab : 0 < a * b := by
        rcases lt_trichotomy (a * b) 0 with hlt | heq | hgt
        · rw [ite_eq_left hlt] at h0
          omega
        · exact absurd heq (mul_ne_zero ha hb)
        · exact hgt
      have h0' : signChanges (b :: t) = 0 := by
        rw [ite_eq_right (not_lt.2 hab.le)] at h0
        omega
      have ih := pairwise_pos_of_signChanges_eq_zero (b :: t)
        (fun x hx => h x (List.mem_cons_of_mem _ hx)) h0'
      have key : ∀ y ∈ b :: t, 0 < a * y := fun y hy => by
        have h1 := ih b (by simp) y hy
        nlinarith [mul_pos hab h1, mul_self_pos.2 hb]
      intro x hx y hy
      rcases List.mem_cons.1 hx with rfl | hx'
      · rcases List.mem_cons.1 hy with rfl | hy'
        · exact mul_self_pos.2 ha
        · exact key y hy'
      · rcases List.mem_cons.1 hy with rfl | hy'
        · rw [mul_comm]
          exact key x hx'
        · exact ih x hx' y hy'

/-- A nonzero sequence with at most one sign change never has a `σ`-negative entry before a
`σ`-positive one, for a suitable `σ = ±1`. -/
theorem pairwise_of_signChanges_le_one :
    ∀ l : List ℤ, (∀ x ∈ l, x ≠ 0) → signChanges l ≤ 1 →
      ∃ s : ℤ, (s = 1 ∨ s = -1) ∧ l.Pairwise (fun x y => ¬ (s * x < 0 ∧ 0 < s * y))
  | [], _, _ => ⟨1, Or.inl rfl, List.Pairwise.nil⟩
  | [_], _, _ => ⟨1, Or.inl rfl, List.pairwise_singleton _ _⟩
  | a :: b :: t, h, h1 => by
      rw [signChanges_cons_cons] at h1
      have ha : a ≠ 0 := h a (by simp)
      have hb : b ≠ 0 := h b (by simp)
      by_cases hab : a * b < 0
      · rw [ite_eq_left hab] at h1
        have h0 : signChanges (b :: t) = 0 := by omega
        have hpos := pairwise_pos_of_signChanges_eq_zero (b :: t)
          (fun x hx => h x (List.mem_cons_of_mem _ hx)) h0
        obtain ⟨s, hs, hsa⟩ : ∃ s : ℤ, (s = 1 ∨ s = -1) ∧ 0 < s * a := by
          rcases lt_or_gt_of_ne ha with hlt | hgt
          · exact ⟨-1, Or.inr rfl, by linarith⟩
          · exact ⟨1, Or.inl rfl, by linarith⟩
        have hneg : ∀ y ∈ b :: t, s * y < 0 := fun y hy => by
          have hby := hpos b (by simp) y hy
          rcases hs with rfl | rfl <;> nlinarith
        refine ⟨s, hs, List.pairwise_cons.2 ⟨fun y _ hc => ?_,
          List.pairwise_of_forall_mem_list fun x _ y hy hc => ?_⟩⟩
        · linarith [hc.1]
        · linarith [hc.2, hneg y hy]
      · have hab' : 0 < a * b := lt_of_le_of_ne (not_lt.1 hab) (mul_ne_zero ha hb).symm
        rw [ite_eq_right hab] at h1
        obtain ⟨s, hs, hpw⟩ := pairwise_of_signChanges_le_one (b :: t)
          (fun x hx => h x (List.mem_cons_of_mem _ hx)) (by omega)
        refine ⟨s, hs, List.pairwise_cons.2 ⟨fun y hy hc => ?_, hpw⟩⟩
        have hsb : s * b < 0 := by
          have := hc.1
          rcases hs with rfl | rfl <;> nlinarith
        rcases List.mem_cons.1 hy with rfl | hy'
        · linarith [hc.2]
        · exact (List.pairwise_cons.1 hpw).1 y hy' ⟨hsb, hc.2⟩

/-- Entries of the filtered list are nonzero. -/
lemma ne_zero_of_mem_filter {k : Fin n → ℤ} :
    ∀ x ∈ (List.ofFn k).filter (fun a => a ≠ 0), x ≠ 0 := fun x hx => by
  simpa using (List.mem_filter.1 hx).2

/-- `var(k) = 0` means all nonzero entries share one sign `σ = ±1`. -/
theorem exists_sign_of_signVar_eq_zero (k : Fin n → ℤ) (hk : signVar k = 0) :
    ∃ σ : ℤ, (σ = 1 ∨ σ = -1) ∧ ∀ j, 0 ≤ σ * k j := by
  have hpos := pairwise_pos_of_signChanges_eq_zero _ ne_zero_of_mem_filter hk
  have hmem : ∀ j, k j ≠ 0 → k j ∈ (List.ofFn k).filter (fun a => a ≠ 0) := fun j hj =>
    List.mem_filter.2 ⟨List.mem_ofFn.2 ⟨j, rfl⟩, by simpa using hj⟩
  by_cases h : ∃ i, k i ≠ 0
  · obtain ⟨i, hi⟩ := h
    rcases lt_or_gt_of_ne hi with hlt | hgt
    · refine ⟨-1, Or.inr rfl, fun j => ?_⟩
      by_cases hj : k j = 0
      · simp [hj]
      · have := hpos _ (hmem i hi) _ (hmem j hj)
        nlinarith
    · refine ⟨1, Or.inl rfl, fun j => ?_⟩
      by_cases hj : k j = 0
      · simp [hj]
      · have := hpos _ (hmem i hi) _ (hmem j hj)
        nlinarith
  · push Not at h
    exact ⟨1, Or.inl rfl, fun j => by simp [h j]⟩

/-- **Threshold form of `var(k) ≤ 1`.** There are `s = ±1` and `q` with `s k_j ≥ 0` for `j < q`
and `s k_j ≤ 0` for `j ≥ q`. -/
theorem exists_threshold_of_signVar_le_one (k : Fin n → ℤ) (hk : signVar k ≤ 1) :
    ∃ s : ℤ, (s = 1 ∨ s = -1) ∧ ∃ q : ℕ, (∀ j : Fin n, (j : ℕ) < q → 0 ≤ s * k j) ∧
      (∀ j : Fin n, q ≤ (j : ℕ) → s * k j ≤ 0) := by
  obtain ⟨s, hs, hpw⟩ := pairwise_of_signChanges_le_one _ ne_zero_of_mem_filter hk
  rw [List.pairwise_filter, List.pairwise_ofFn] at hpw
  have hR : ∀ i j : Fin n, i < j → ¬ (s * k i < 0 ∧ 0 < s * k j) := fun i j hij hc => by
    refine hpw hij ?_ ?_ hc
    · simp only [ne_eq, decide_not, Bool.not_eq_eq_eq_not, Bool.not_true, decide_eq_false_iff_not]
      rintro h0
      rw [h0, mul_zero] at hc
      exact lt_irrefl _ hc.1
    · simp only [ne_eq, decide_not, Bool.not_eq_eq_eq_not, Bool.not_true, decide_eq_false_iff_not]
      rintro h0
      rw [h0, mul_zero] at hc
      exact lt_irrefl _ hc.2
  refine ⟨s, hs, ?_⟩
  classical
  by_cases hN : (Finset.univ.filter (fun i : Fin n => s * k i < 0)).Nonempty
  · set i₀ := (Finset.univ.filter (fun i : Fin n => s * k i < 0)).min' hN with hi₀
    have hi₀mem : s * k i₀ < 0 := by
      have := Finset.min'_mem _ hN
      rw [← hi₀] at this
      simpa using this
    refine ⟨(i₀ : ℕ), fun j hj => ?_, fun j hj => ?_⟩
    · by_contra hc
      push Not at hc
      have hle : i₀ ≤ j := by
        rw [hi₀]
        exact Finset.min'_le _ _ (by simpa using hc)
      exact absurd hj (not_lt.2 hle)
    · rcases eq_or_lt_of_le (show i₀ ≤ j from hj) with heq | hlt
      · rw [← heq]
        exact hi₀mem.le
      · by_contra hc
        push Not at hc
        exact hR i₀ j hlt ⟨hi₀mem, hc⟩
  · refine ⟨n, fun j _ => ?_, fun j hj => absurd j.isLt (not_lt.2 hj)⟩
    by_contra hc
    push Not at hc
    exact hN ⟨j, by simpa using hc⟩


/-! ### Coercivity on the thinned spectrum -/

/-- `k ↦ Lᵀk` is **coercive on the thinned index set**: `∃ c > 0`, `c Σ_j |k_j| ≤ ‖Lᵀk‖` for
every `k ∈ ℤⁿ` with `var(k) < d`.

Source: the property behind SI §S1 (discreteness of `Λ'`). -/
def ThinnedCoercive (L : Matrix (Fin n) (Fin d) ℝ) : Prop :=
  ∃ c : ℝ, 0 < c ∧ ∀ k : Fin n → ℤ, signVar k < d →
    c * ∑ j, |(k j : ℝ)| ≤ ‖Lᵀ *ᵥ (fun j => (k j : ℝ))‖

/-- A nonzero integer vector has `Σ_j |k_j| ≥ 1`. Source: elementary. -/
lemma one_le_sum_abs_of_ne_zero {k : Fin n → ℤ} (hk : k ≠ 0) : (1 : ℝ) ≤ ∑ j, |(k j : ℝ)| := by
  obtain ⟨j, hj⟩ : ∃ j, k j ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hk (funext hcon)
  have h1 : (1 : ℝ) ≤ |(k j : ℝ)| := by
    rw [← Int.cast_abs]
    exact_mod_cast Int.one_le_abs hj
  exact h1.trans (Finset.single_le_sum (fun i _ => abs_nonneg ((k i : ℝ))) (Finset.mem_univ j))

/-- Casting the zero integer vector. Source: elementary. -/
lemma intCast_vec_eq_zero {k : Fin n → ℤ} (h : k = 0) : (fun j => (k j : ℝ)) = 0 := by
  subst h
  funext j
  simp

/-- Coercivity makes `k ↦ Lᵀk` injective on `{var(k) < d}`. -/
theorem ThinnedCoercive.injective {L : Matrix (Fin n) (Fin d) ℝ} (h : ThinnedCoercive L)
    {k : Fin n → ℤ} (hk : signVar k < d) (h0 : Lᵀ *ᵥ (fun j => (k j : ℝ)) = 0) : k = 0 := by
  obtain ⟨c, hc, hL⟩ := h
  by_contra hne
  have h1 := hL k hk
  rw [h0, norm_zero] at h1
  have h2 := one_le_sum_abs_of_ne_zero hne
  nlinarith

/-- **Exclusion zone.** A coercive generator has a punctured ball around the origin free of
points of `Λ'` (in contrast to the ambient module `M_L`).

Source: SI §S1 ("`Λ'` … is a discrete … set"). -/
theorem ThinnedCoercive.exclusion {L : Matrix (Fin n) (Fin d) ℝ} (h : ThinnedCoercive L) :
    ∃ ε > 0, ∀ ξ ∈ extinctionSpectrum L, ξ ≠ 0 → ε ≤ ‖ξ‖ := by
  obtain ⟨c, hc, hL⟩ := h
  refine ⟨c, hc, ?_⟩
  rintro ξ ⟨k, hk, rfl⟩ hξ
  have hk0 : k ≠ 0 := fun h0 => hξ (by rw [intCast_vec_eq_zero h0, mulVec_zero])
  have h1 := hL k hk
  have h2 := one_le_sum_abs_of_ne_zero hk0
  nlinarith

/-- **Local finiteness.** A coercive generator has a locally finite thinned spectrum:
`Λ' ∩ {‖ξ‖ ≤ R}` is finite for every `R`.

Source: SI §S1 ("`Λ'` … is a discrete … set"). -/
theorem ThinnedCoercive.finite_inter_closedBall {L : Matrix (Fin n) (Fin d) ℝ}
    (h : ThinnedCoercive L) (R : ℝ) : {ξ ∈ extinctionSpectrum L | ‖ξ‖ ≤ R}.Finite := by
  obtain ⟨c, hc, hL⟩ := h
  set B : ℤ := ⌈R / c⌉ with hB
  refine ((Set.finite_Icc (fun _ : Fin n => -B) (fun _ => B)).image
    (fun k : Fin n → ℤ => Lᵀ *ᵥ (fun j => (k j : ℝ)))).subset ?_
  rintro ξ ⟨⟨k, hk, rfl⟩, hR⟩
  refine ⟨k, ?_, rfl⟩
  have hS : ∑ j, |(k j : ℝ)| ≤ R / c := by
    rw [le_div_iff₀ hc]
    linarith [hL k hk]
  have hj : ∀ j, |k j| ≤ B := fun j => by
    have h1 : |(k j : ℝ)| ≤ ∑ i, |(k i : ℝ)| :=
      Finset.single_le_sum (fun i _ => abs_nonneg ((k i : ℝ))) (Finset.mem_univ j)
    have h2 : ((|k j| : ℤ) : ℝ) ≤ (B : ℝ) := by
      rw [Int.cast_abs]
      exact h1.trans (hS.trans (Int.le_ceil _))
    exact_mod_cast h2
  exact ⟨fun j => (abs_le.1 (hj j)).1, fun j => (abs_le.1 (hj j)).2⟩

/-- `|x| = σx` when `σ = ±1` and `σx ≥ 0`. Source: elementary. -/
lemma abs_intCast_eq_sign_mul {σ x : ℤ} (hσ : σ = 1 ∨ σ = -1) (h : 0 ≤ σ * x) :
    |(x : ℝ)| = (σ : ℝ) * x := by
  rcases hσ with rfl | rfl
  · rw [one_mul] at h
    rw [Int.cast_one, one_mul]
    exact abs_of_nonneg (by exact_mod_cast h)
  · rw [neg_one_mul] at h
    rw [Int.cast_neg, Int.cast_one, neg_one_mul]
    exact abs_of_nonpos (by have : x ≤ 0 := by omega
                            exact_mod_cast this)

/-- **Coercivity, `d = 1`.** If every entry of the scalar generator is positive
(`L ∈ Gr₊(1,n)`), then `(min_j L_j) Σ_j |k_j| ≤ |Lᵀk|` whenever `var(k) = 0`.

Source: manuscript eq. (1); SI §S1 (discreteness of `Λ'`). -/
theorem thinnedCoercive_colGen {L : Fin n → ℝ} (hL : ∀ j, 0 < L j) :
    ThinnedCoercive (colGen L) := by
  by_cases hn : Nonempty (Fin n)
  · obtain ⟨j₀, hj₀⟩ := Finite.exists_min L
    refine ⟨L j₀, hL j₀, fun k hk => ?_⟩
    have hk0 : signVar k = 0 := by omega
    obtain ⟨σ, hσ, hsign⟩ := exists_sign_of_signVar_eq_zero k hk0
    have hval : ((colGen L)ᵀ *ᵥ (fun j => (k j : ℝ))) 0 = ∑ j, (k j : ℝ) * L j := by
      simp only [mulVec, dotProduct, transpose_apply, colGen, replicateCol_apply]
      exact Finset.sum_congr rfl fun j _ => mul_comm _ _
    have hσabs : |(σ : ℝ)| = 1 := by rcases hσ with rfl | rfl <;> simp
    calc L j₀ * ∑ j, |(k j : ℝ)| = ∑ j, |(k j : ℝ)| * L j₀ := by
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl fun j _ => mul_comm _ _
      _ ≤ ∑ j, |(k j : ℝ)| * L j :=
          Finset.sum_le_sum fun j _ => mul_le_mul_of_nonneg_left (hj₀ j) (abs_nonneg _)
      _ = (σ : ℝ) * ∑ j, (k j : ℝ) * L j := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [abs_intCast_eq_sign_mul hσ (hsign j), mul_assoc]
      _ ≤ |(σ : ℝ) * ∑ j, (k j : ℝ) * L j| := le_abs_self _
      _ = |((colGen L)ᵀ *ᵥ (fun j => (k j : ℝ))) 0| := by rw [abs_mul, hσabs, one_mul, hval]
      _ ≤ ‖(colGen L)ᵀ *ᵥ (fun j => (k j : ℝ))‖ := by
          simpa [Real.norm_eq_abs] using norm_le_pi_norm ((colGen L)ᵀ *ᵥ (fun j => (k j : ℝ))) 0
  · refine ⟨1, one_pos, fun k _ => ?_⟩
    rw [not_nonempty_iff] at hn
    rw [Finset.univ_eq_empty, Finset.sum_empty, mul_zero]
    exact norm_nonneg _

/-! ### `d = 2` -/

/-- The planar cross product `a × x = a₀x₁ − a₁x₀` (so `ℓ_i × ℓ_j = Δ_{ij}`).

Source: SI eq. (S1.2) / Chart `minor2` (`d = 2`). -/
def cross2 (a x : Fin 2 → ℝ) : ℝ :=
  a 0 * x 1 - a 1 * x 0

/-- `a × (Lᵀk) = Σ_j k_j (a × ℓ_j)`. -/
lemma cross2_transpose_mulVec (L : Matrix (Fin n) (Fin 2) ℝ) (a : Fin 2 → ℝ) (k : Fin n → ℤ) :
    cross2 a (Lᵀ *ᵥ (fun j => (k j : ℝ))) = ∑ j, (k j : ℝ) * cross2 a (L j) := by
  simp only [cross2, mulVec, dotProduct, transpose_apply, Finset.mul_sum,
    ← Finset.sum_sub_distrib]
  exact Finset.sum_congr rfl fun j _ => by ring

/-- `|a × x| ≤ (|a₀| + |a₁|) ‖x‖_∞`. Source: elementary. -/
lemma abs_cross2_le (a x : Fin 2 → ℝ) : |cross2 a x| ≤ (|a 0| + |a 1|) * ‖x‖ := by
  have h0 : |x 0| ≤ ‖x‖ := by simpa [Real.norm_eq_abs] using norm_le_pi_norm x 0
  have h1 : |x 1| ≤ ‖x‖ := by simpa [Real.norm_eq_abs] using norm_le_pi_norm x 1
  calc |cross2 a x| ≤ |a 0 * x 1| + |a 1 * x 0| := abs_sub _ _
    _ = |a 0| * |x 1| + |a 1| * |x 0| := by rw [abs_mul, abs_mul]
    _ ≤ |a 0| * ‖x‖ + |a 1| * ‖x‖ :=
        add_le_add (mul_le_mul_of_nonneg_left h1 (abs_nonneg _))
          (mul_le_mul_of_nonneg_left h0 (abs_nonneg _))
    _ = (|a 0| + |a 1|) * ‖x‖ := by ring

/-- Linearity of `×` in the first argument. Source: elementary. -/
lemma cross2_add_left (a b x : Fin 2 → ℝ) : cross2 (a + b) x = cross2 a x + cross2 b x := by
  simp only [cross2, Pi.add_apply]
  ring

/-- Linearity of `×` in the first argument. Source: elementary. -/
lemma cross2_sub_left (a b x : Fin 2 → ℝ) : cross2 (a - b) x = cross2 a x - cross2 b x := by
  simp only [cross2, Pi.sub_apply]
  ring

/-- `ℓ_i × ℓ_j = Δ_{ij}`. Source: SI eq. (S1.2), `d = 2`. -/
lemma cross2_rows (L : Matrix (Fin n) (Fin 2) ℝ) (i j : Fin n) :
    cross2 (L i) (L j) = minor2 L i j := rfl

/-- Antisymmetry of the minors. Source: SI eq. (S1.2), `d = 2`. -/
lemma minor2_swap (L : Matrix (Fin n) (Fin 2) ℝ) (i j : Fin n) :
    minor2 L j i = -minor2 L i j := by
  simp only [minor2]
  ring

/-- `Δ_{ij} ≥ 0` for `i ≤ j` when `L ∈ Gr₊(2,n)`. Source: SI eq. (S1.2), `d = 2`. -/
lemma minor2_nonneg_of_le {L : Matrix (Fin n) (Fin 2) ℝ} (hL : InGrPlus2 L) {i j : Fin n}
    (h : i ≤ j) : 0 ≤ minor2 L i j := by
  rcases eq_or_lt_of_le h with rfl | hlt
  · simp only [minor2]
    nlinarith
  · exact (hL i j hlt).le

/-- **Coercivity, `d = 2`.** If `n ≥ 2` and every `2 × 2` minor of `L` is positive
(`L ∈ Gr₊(2,n)`, the deployed chart), there is `c > 0` with `c Σ_j |k_j| ≤ ‖Lᵀk‖` whenever
`var(k) ≤ 1`.  Proof: a sequence with at most one sign change is separated by one of the `n`
functionals `x ↦ ℓ_{q−1} × x + ℓ_q × x` (or `x ↦ ℓ_1 × x − ℓ_n × x`), whose signs on the rows are
fixed by the positive minors.

Source: manuscript eq. (1) and Prop. 2 (`L ∈ Gr₊(2,n)`); SI §S1
("`Λ'` … is a discrete … set"). -/
theorem thinnedCoercive_of_inGrPlus2 {L : Matrix (Fin n) (Fin 2) ℝ} (hn : 2 ≤ n)
    (hL : InGrPlus2 L) : ThinnedCoercive L := by
  set first : Fin n := ⟨0, by omega⟩ with hfirst
  set last : Fin n := ⟨n - 1, by omega⟩ with hlast
  set prev : Fin n → Fin n := fun q => ⟨(q : ℕ) - 1, by omega⟩ with hprev
  set a : Fin n → Fin 2 → ℝ :=
    fun q => if (q : ℕ) = 0 then L first - L last else L (prev q) + L q with ha
  have hA0 : ∀ q : Fin n, (q : ℕ) = 0 → ∀ j, 0 < cross2 (a q) (L j) := by
    intro q hq j
    simp only [ha, ite_eq_left hq]
    rw [cross2_sub_left, cross2_rows, cross2_rows, minor2_swap L j last]
    have hfl : first < last := by rw [Fin.lt_def]; simp [hfirst, hlast]; omega
    have hjl : j ≤ last := by rw [Fin.le_def]; simp [hlast]; omega
    by_cases hj : (j : ℕ) = 0
    · have hjf : j = first := Fin.ext (by simp [hfirst, hj])
      subst hjf
      have h1 := hL first last hfl
      have h2 : minor2 L first first = 0 := by simp only [minor2]; ring
      linarith
    · have hfj : first < j := by rw [Fin.lt_def]; simp [hfirst]; omega
      have h1 := hL first j hfj
      have h2 := minor2_nonneg_of_le hL hjl
      linarith
  have hAq : ∀ q : Fin n, (q : ℕ) ≠ 0 → ∀ j : Fin n,
      ((j : ℕ) < q → cross2 (a q) (L j) < 0) ∧ ((q : ℕ) ≤ j → 0 < cross2 (a q) (L j)) := by
    intro q hq j
    simp only [ha, ite_eq_right hq]
    rw [cross2_add_left, cross2_rows, cross2_rows]
    constructor
    · intro hjq
      have hjp : j ≤ prev q := by rw [Fin.le_def]; simp [hprev]; omega
      have hjq' : j < q := by rw [Fin.lt_def]; exact hjq
      rw [minor2_swap L j (prev q), minor2_swap L j q]
      have h1 := minor2_nonneg_of_le hL hjp
      have h2 := hL j q hjq'
      linarith
    · intro hqj
      have hpj : prev q < j := by rw [Fin.lt_def]; simp [hprev]; omega
      have hqj' : q ≤ j := by rw [Fin.le_def]; exact hqj
      have h1 := hL (prev q) j hpj
      have h2 := minor2_nonneg_of_le hL hqj'
      linarith
  have hne : ∀ q j, cross2 (a q) (L j) ≠ 0 := by
    intro q j
    by_cases hq : (q : ℕ) = 0
    · exact (hA0 q hq j).ne'
    · rcases lt_or_ge (j : ℕ) q with hjq | hqj
      · exact ((hAq q hq j).1 hjq).ne
      · exact ((hAq q hq j).2 hqj).ne'
  have : Nonempty (Fin n × Fin n) := ⟨(first, first)⟩
  obtain ⟨⟨q₀, j₀⟩, hmin⟩ := Finite.exists_min (fun p : Fin n × Fin n => |cross2 (a p.1) (L p.2)|)
  set δ := |cross2 (a q₀) (L j₀)| with hδ
  have hδpos : 0 < δ := abs_pos.2 (hne q₀ j₀)
  set C : ℝ := ∑ q, (|a q 0| + |a q 1|) + 1 with hC
  have hCq : ∀ q, |a q 0| + |a q 1| ≤ C := fun q => by
    have := Finset.single_le_sum (f := fun q => |a q 0| + |a q 1|)
      (fun i _ => add_nonneg (abs_nonneg _) (abs_nonneg _)) (Finset.mem_univ q)
    linarith
  have hCpos : 0 < C := by
    have := Finset.sum_nonneg (s := Finset.univ) (f := fun q => |a q 0| + |a q 1|)
      (fun i _ => add_nonneg (abs_nonneg _) (abs_nonneg _))
    linarith
  refine ⟨δ / C, div_pos hδpos hCpos, fun k hk => ?_⟩
  obtain ⟨s, hs, q', hlow, hhigh⟩ := exists_threshold_of_signVar_le_one k (by omega)
  obtain ⟨q, σ, hσ, hprod⟩ : ∃ q : Fin n, ∃ σ : ℝ, (σ = 1 ∨ σ = -1) ∧
      ∀ j, 0 ≤ σ * ((k j : ℝ) * cross2 (a q) (L j)) := by
    by_cases hq : q' = 0 ∨ n ≤ q'
    · obtain ⟨σ, hσ, hσk⟩ : ∃ σ : ℝ, (σ = 1 ∨ σ = -1) ∧ ∀ j, 0 ≤ σ * k j := by
        rcases hq with h0 | hn'
        · refine ⟨-(s : ℝ), ?_, fun j => ?_⟩
          · rcases hs with rfl | rfl <;> simp
          · have h1 : (s : ℝ) * k j ≤ 0 := by exact_mod_cast hhigh j (by omega)
            linarith
        · refine ⟨(s : ℝ), ?_, fun j => ?_⟩
          · rcases hs with rfl | rfl <;> simp
          · exact_mod_cast hlow j (by omega)
      refine ⟨first, σ, hσ, fun j => ?_⟩
      rw [← mul_assoc]
      exact mul_nonneg (hσk j) (hA0 first rfl j).le
    · push Not at hq
      refine ⟨⟨q', hq.2⟩, -(s : ℝ), ?_, fun j => ?_⟩
      · rcases hs with rfl | rfl <;> simp
      obtain ⟨hlt, hge⟩ := hAq ⟨q', hq.2⟩ hq.1 j
      by_cases hj : (j : ℕ) < q'
      · have h1 : (0 : ℝ) ≤ s * k j := by exact_mod_cast hlow j hj
        have h2 := hlt hj
        nlinarith
      · have h1 : (s : ℝ) * k j ≤ 0 := by exact_mod_cast hhigh j (by omega)
        have h2 := hge (show q' ≤ (j : ℕ) by omega)
        nlinarith
  have hσabs : |σ| = 1 := by rcases hσ with rfl | rfl <;> simp
  have hterm : ∀ j, |(k j : ℝ)| * δ ≤ σ * ((k j : ℝ) * cross2 (a q) (L j)) := fun j => by
    rw [← abs_of_nonneg (hprod j), abs_mul, hσabs, one_mul, abs_mul]
    exact mul_le_mul_of_nonneg_left (hmin (q, j)) (abs_nonneg _)
  have hsum : (∑ j, |(k j : ℝ)|) * δ ≤ σ * cross2 (a q) (Lᵀ *ᵥ (fun j => (k j : ℝ))) := by
    rw [cross2_transpose_mulVec, Finset.mul_sum, Finset.sum_mul]
    exact Finset.sum_le_sum fun j _ => hterm j
  have hle : σ * cross2 (a q) (Lᵀ *ᵥ (fun j => (k j : ℝ))) ≤
      C * ‖Lᵀ *ᵥ (fun j => (k j : ℝ))‖ := by
    calc σ * cross2 (a q) (Lᵀ *ᵥ (fun j => (k j : ℝ)))
        ≤ |σ * cross2 (a q) (Lᵀ *ᵥ (fun j => (k j : ℝ)))| := le_abs_self _
      _ = |cross2 (a q) (Lᵀ *ᵥ (fun j => (k j : ℝ)))| := by rw [abs_mul, hσabs, one_mul]
      _ ≤ (|a q 0| + |a q 1|) * ‖Lᵀ *ᵥ (fun j => (k j : ℝ))‖ := abs_cross2_le _ _
      _ ≤ C * ‖Lᵀ *ᵥ (fun j => (k j : ℝ))‖ :=
          mul_le_mul_of_nonneg_right (hCq q) (norm_nonneg _)
  rw [div_mul_eq_mul_div, div_le_iff₀ hCpos]
  nlinarith

/-! ### Public statements: `Λ'` versus `M_L` -/

/-- **`d = 2`: the thinned spectrum has an exclusion zone.** For `n ≥ 2` and
`L ∈ Gr₊(2,n)` (every `2 × 2` minor positive), there is `ε > 0` such that every nonzero
`ξ ∈ Λ' = {Lᵀk : var(k) < 2}` has `‖ξ‖ ≥ ε`.

Source: manuscript eq. (1) with Prop. 2 (`L ∈ Gr₊(2,n)`, deployed `d = 2`);
SI §S1 (`Λ'` "discrete"). Accumulation of nonzero Bragg peaks at the origin and density are
properties of the ambient module `M_L`, not of `Λ'`. -/
theorem extinctionSpectrum_exclusion_zone_of_inGrPlus2 {L : Matrix (Fin n) (Fin 2) ℝ}
    (hn : 2 ≤ n) (hL : InGrPlus2 L) :
    ∃ ε > 0, ∀ ξ ∈ extinctionSpectrum L, ξ ≠ 0 → ε ≤ ‖ξ‖ :=
  (thinnedCoercive_of_inGrPlus2 hn hL).exclusion

/-- **`d = 2`: the thinned spectrum is locally finite.** For `n ≥ 2` and
`L ∈ Gr₊(2,n)`, `Λ' ∩ {‖ξ‖ ≤ R}` is finite for every `R`.

Source: SI §S1 and the §S1 summary table ("`Λ'` … discrete and nonlattice"). -/
theorem extinctionSpectrum_finite_inter_closedBall_of_inGrPlus2 {L : Matrix (Fin n) (Fin 2) ℝ}
    (hn : 2 ≤ n) (hL : InGrPlus2 L) (R : ℝ) :
    {ξ ∈ extinctionSpectrum L | ‖ξ‖ ≤ R}.Finite :=
  (thinnedCoercive_of_inGrPlus2 hn hL).finite_inter_closedBall R

/-- **Deployed chart.** For every chart parameter `φ` (manuscript eq. (10)) and `n ≥ 2`,
the thinned spectrum of `L(φ)` has an exclusion zone around the origin.

Source: manuscript eq. (10), Prop. 2; SI §S1. -/
theorem chartL_extinctionSpectrum_exclusion_zone (hn : 2 ≤ n) (φ : ChartParams n) :
    ∃ ε > 0, ∀ ξ ∈ extinctionSpectrum (chartL φ), ξ ≠ 0 → ε ≤ ‖ξ‖ :=
  extinctionSpectrum_exclusion_zone_of_inGrPlus2 hn (chartL_inGrPlus2 φ)

/-- **`d = 1`: the thinned spectrum has an exclusion zone.** For a scalar generator with
positive entries (`L ∈ Gr₊(1,n)`), every nonzero `ξ ∈ Λ' = {Lᵀk : var(k) = 0}` has `‖ξ‖ ≥ ε`
for some `ε > 0`, and `Λ'` is locally finite.

Source: manuscript eq. (1); SI §S1. -/
theorem extinctionSpectrum_colGen_discrete {L : Fin n → ℝ} (hL : ∀ j, 0 < L j) :
    (∃ ε > 0, ∀ ξ ∈ extinctionSpectrum (colGen L), ξ ≠ 0 → ε ≤ ‖ξ‖) ∧
      ∀ R : ℝ, {ξ ∈ extinctionSpectrum (colGen L) | ‖ξ‖ ≤ R}.Finite :=
  ⟨(thinnedCoercive_colGen hL).exclusion, (thinnedCoercive_colGen hL).finite_inter_closedBall⟩

/-- **Contrast theorem (`d = 1`).** For a positive scalar generator with an irrational ratio of two
entries, the thinned spectrum `Λ'` has an exclusion zone, while the ambient module `M_L` has none
(its nonzero points accumulate at the origin). Density and the absence of an exclusion zone are
properties of `M_L`, not of `Λ'`.

Source: SI §S1. -/
theorem extinctionSpectrum_vs_spectrumModule {L : Fin n → ℝ} (hL : ∀ j, 0 < L j)
    (h : ∃ i j, L i ≠ 0 ∧ Irrational (L j / L i)) :
    (∃ ε > 0, ∀ ξ ∈ extinctionSpectrum (colGen L), ξ ≠ 0 → ε ≤ ‖ξ‖) ∧
      ∀ ε > 0, ∃ ξ ∈ spectrumModule (colGen L), ξ ≠ 0 ∧ ‖ξ‖ < ε :=
  ⟨(extinctionSpectrum_colGen_discrete hL).1,
    fun _ hε => exists_small_nonzero_mem_spectrumModule h hε⟩

/-- **Concrete instance.** For `L = (1, √2)`, `Λ'` has an exclusion zone but `M_L = ℤ + √2 ℤ`
does not.

Source: SI §S1. -/
theorem extinctionSpectrum_vs_spectrumModule_sqrt_two :
    (∃ ε > 0, ∀ ξ ∈ extinctionSpectrum (colGen ![1, √2]), ξ ≠ 0 → ε ≤ ‖ξ‖) ∧
      ∀ ε > 0, ∃ ξ ∈ spectrumModule (colGen ![1, √2]), ξ ≠ 0 ∧ ‖ξ‖ < ε := by
  refine extinctionSpectrum_vs_spectrumModule (fun j => ?_) ⟨0, 1, by simp, ?_⟩
  · fin_cases j <;> simp
  · simpa using irrational_sqrt_two

end FQGNN.Backbone
